# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
# The guild (server) ID the bot lives in (Developer Mode -> right-click server -> Copy Server ID)
GUILD_ID=123456789012345678
# Comma-separated Discord user IDs allowed to use the admin commands
ADMIN_IDS=111111111111111111

# --- Google Sheets ---
# Spreadsheet ID from the sheet's URL (the long string after /d/)
GOOGLE_SPREADSHEET_ID=1AbC...xyz
# Path to the service account JSON key (see README for how to create one)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# --- Roles (created by /admin setup if missing) ---
PARTICIPANT_ROLE_NAME=League Participant
SEED_NOT_DONE_ROLE_NAME=League Seed Not Done

# --- Optional ---
# Set to 1 to skip all Google Sheets writes (they are logged instead).
# Useful for testing the bot without Google credentials.
DRY_RUN=0
# How often (in minutes) the bot re-syncs the "seed not done" role.
RECONCILE_MINUTES=1
